# PostgreSQL for local development and the test suite. swisha itself runs
# on the host.
#
#   docker compose -f examples/docker-compose.yml.example up -d
#   export SWISHA_TEST_DATABASE_URL=\
#     postgres://swisha:swisha@localhost:5433/swisha_test
#   cargo test
#
# Port 5433, not 5432, so this cannot collide with a PostgreSQL already
# on the host.

services:
  postgres:
    image: postgres:16
    container_name: swisha-pg
    restart: unless-stopped
    environment:
      POSTGRES_USER: swisha
      POSTGRES_PASSWORD: swisha
      POSTGRES_DB: swisha_test
    ports:
      - "5433:5432"
    volumes:
      - swisha-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U swisha -d swisha_test"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  swisha-pgdata:

# This is a development database. The password is in plain text on purpose,
# because nothing here should ever hold real payouts. Production PostgreSQL
# belongs outside Docker, or at least outside this file.
#
# The test suite creates its own tables under a unique prefix per test and
# sweeps what earlier runs left behind, so one container serves every run.
# To start clean anyway:
#
#   docker compose -f examples/docker-compose.yml.example down -v
