# swisha, development. Talks to Swish's MSS simulator, so no real money moves.
#
#   cp swisha.dev.example dev.env
#   createdb swisha && swisha --print-schema | psql swisha
#   SWISHA_ENV_FILE=dev.env swisha
#
# Fields are blank, and blank means the default. Fill in the ones marked
# required. SWISH_ENV is already set for this file.
#
# Keys must be PKCS#8, the form that starts -----BEGIN PRIVATE KEY-----.
# For a PKCS#1 key: openssl pkcs8 -topk8 -nocrypt -in in.key -out out.key

# Database
# PostgreSQL. A path in DB_HOST is treated as a Unix socket directory.

DB_HOST=               # default localhost:5432
DB_NAME=               # required
DB_USER=               # required
DB_PASS=               # blank for peer authentication

# Tables
# Change these only when two services share one database.

TABLE_PAYOUTS=         # default swisha_payouts
TABLE_LOGS=            # default swisha_logs
TABLE_EVENTS=          # default swisha_events
NOTIFY_PREFIX=         # default swisha

# Listeners
# The internal API serves payout, status, health and events. A Unix socket is
# guarded by its file permissions and needs no secret. Setting the socket
# leaves the address below unused.

SWISH_SERVER_SOCKET=   # e.g. /run/swisha/swisha.sock
SWISH_SERVER_ADDR=     # default 127.0.0.1:8083
SWISH_CALLBACK_ADDR=   # default 127.0.0.1:8084
TRUSTED_PROXY=         # default 127.0.0.1

# Swish
# The callback URL has to be set even locally. swisha also polls, so a payout
# still resolves if Swish never reaches you, it just takes seconds rather than
# milliseconds. For a real callback locally, run a tunnel:
#
#   cloudflared tunnel --url http://localhost:8084

SWISH_ENV=test         # the MSS simulator. No money moves
SWISH_NUMBER=          # required. 1234679304 in the test bundle
SWISH_MAX_PAYOUT=      # min 1 SEK, default 50000, max 150000
SWISH_CALLBACK_URL=    # required. https, ending in /swish/callback

# Certificates
# From Swish's developer portal, as downloaded, no renaming. The test bundle
# ships a separate signing pair and MSS rejects a payout signed with anything
# else, so both signing lines are needed here.

SWISH_CERT=            # required
SWISH_KEY=             # required
SWISH_SIGNING_CERT=    # required. MSS rejects the merchant key
SWISH_SIGNING_KEY=     # required. its matching key
SWISH_CA=              # the bundle's root CA, which the system store lacks

# API
# The secret guards the payout endpoint when it listens on a port. It is not a
# Swish credential, you generate it: openssl rand -hex 32
# The payout message is what the recipient reads in their Swish app.

API_SHARED_SECRET=     # min 16 characters, blank only behind a socket
SWISH_PAYOUT_MESSAGE=  # 50 chars, {reference} substituted
SWISH_ERROR_LANG=      # en or sv, default en
SWISH_REQUIRE_SSN=     # true refuses payouts without one

# Logging

RUST_LOG=              # error, warn, info, debug, trace. Default info
